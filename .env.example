# Optional local overrides; Docker Compose configures its own absolute paths.
# CAREER_QUEST_DB_PATH=.data/career-quest.sqlite
# CAREER_QUEST_DATA_DIR=data
# APP_PORT=3000
# APP_BIND_ADDRESS=127.0.0.1
# Must exactly match the browser origin. For TLS deployment use https://your-internal-host.
APP_ORIGIN=http://localhost:3000
# Set false for a deployment that must make no external AI calls.
AI_EXPLANATIONS_ENABLED=true
# Server only. Missing key keeps deterministic recommendations working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
